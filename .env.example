# Bu fayl saytni sozlaydi. O'zgartirgandan keyin serverni qayta ishga tushiring.
SITE_PROFILE=university
PORT=3000

# Birinchi kirish uchun login/parol. BIRINCHI KIRISHDAN KEYIN ALBATTA O'ZGARTIRING!
DEFAULT_STAFF_EMAIL=staff@kokandu.uz
DEFAULT_STAFF_PASSWORD=
DEFAULT_EDITOR_EMAIL=admin@kokandu.uz
DEFAULT_EDITOR_PASSWORD=

# --- Avto-tarjima (admin paneldagi o'zbekcha matn -> EN/RU) ---
# PROVIDER tanlovi:
#   google  -> Google Cloud Translation v2 (ishonchli, pullik). GOOGLE_TRANSLATE_KEY shart.
#   gtx     -> bepul endpoint (kalit kerak emas, lekin ko'p so'rovda bloklanishi mumkin).
#   mock    -> test uchun: "[EN] matn" ko'rinishida (tarjima qilmaydi).
#   none    -> avto-tarjima o'chiq (faqat lug'atdagi qo'lbola tarjimalar ishlaydi).
# Bo'sh qoldirilsa: GOOGLE_TRANSLATE_KEY bo'lsa 'google', aks holda 'gtx'.
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_KEY=

# --- Railway / VPS (production) uchun ---
# Bularni Railway'da Variables bo'limiga yozasiz, .env fayl kerak emas.
# NODE_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}   <- Railway o'zi to'ldiradi
# UPLOAD_DIR=/data/uploads                  <- Volume mount qilingan bo'lsa
# TRANSLATE_PROVIDER=google                 <- avto-tarjima uchun (tepaga qarang)
# GOOGLE_TRANSLATE_KEY=...                  <- Google Cloud Translation API kaliti
